<Window x:Class="MangaReader.AllPagesPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, StringFormat='Toutes les pages - {0}'}" 
        Height="800" Width="1400"
        Background="#1a1a1a" 
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="PageThumbnail" TargetType="Border">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                    <Setter Property="Background" Value="#3d3d40"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3d3d40"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#1e1e1e" BorderBrush="#404040" BorderThickness="0,0,0,1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bouton Retour -->
                <Button x:Name="BackButton" 
                        Grid.Column="0"
                        Style="{StaticResource PreviewButton}"
                        Click="BackButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="← Retour" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Titre et info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="MangaTitleText"
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                    <TextBlock x:Name="PageCountText"
                               Foreground="#CCCCCC" 
                               FontSize="12"/>
                </StackPanel>

                <!-- Taille des miniatures -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Taille:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="ThumbnailSizeSlider"
                            Minimum="100" Maximum="300" Value="150"
                            Width="100"
                            VerticalAlignment="Center"
                            ValueChanged="ThumbnailSizeSlider_ValueChanged"/>
                </StackPanel>

                <!-- Bouton Commencer la lecture -->
                <Button x:Name="StartReadingButton" 
                        Grid.Column="3"
                        Style="{StaticResource PreviewButton}"
                        Click="StartReadingButton_Click"
                        Background="#007ACC">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📖" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Commencer la lecture" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Grille de toutes les pages -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20">
            <ItemsControl x:Name="AllPagesControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PageThumbnail}" 
                                Width="{Binding ThumbnailSize}" 
                                Height="{Binding ThumbnailHeight}"
                                MouseLeftButtonDown="PageThumbnail_Click"
                                Tag="{Binding}">
                            <Grid>
                                <Image Source="{Binding Image}" 
                                       Stretch="UniformToFill"/>
                                <Border Background="#80000000" 
                                        VerticalAlignment="Bottom"
                                        Padding="8,4">
                                    <TextBlock Text="{Binding PageNumber}" 
                                               Foreground="White" 
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Barre de statut -->
        <Border Grid.Row="2" Background="#1e1e1e" BorderBrush="#404040" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" 
                           Grid.Column="0"
                           Text="Chargement des miniatures..."
                           Foreground="#CCCCCC" 
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <ProgressBar x:Name="LoadingProgressBar"
                             Grid.Column="1"
                             Width="200" Height="15"
                             Minimum="0" Maximum="100" Value="0"
                             Visibility="Visible"/>
            </Grid>
        </Border>
    </Grid>
</Window>