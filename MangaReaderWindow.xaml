<Window x:Class="MangaReader.MangaReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, StringFormat='Manga Reader - {0}'}" 
        Height="900" Width="1400"
        Background="{DynamicResource BackgroundColor}"
        WindowState="Maximized"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="ReaderButton" TargetType="Button">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3d3d40"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre d'outils -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundColor}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bouton Retour -->
                <Button x:Name="BackButton" 
                        Grid.Column="0"
                        Style="{StaticResource ReaderButton}"
                        Click="BackButton_Click"
                        Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="← Retour" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Informations du manga -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="MangaTitleText" 
                               Text="{Binding Title}"
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageInfoText" 
                               Text="Page 1 / 1"
                               Foreground="#CCCCCC" 
                               FontSize="12"/>
                </StackPanel>

                <!-- Mode de lecture -->
                <ComboBox x:Name="ReadingModeComboBox" 
                          Grid.Column="2"
                          Width="150"
                          Margin="10,0"
                          SelectionChanged="ReadingModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Page simple" IsSelected="True"/>
                    <ComboBoxItem Content="Double page"/>
                    <ComboBoxItem Content="Défilement continu"/>
                </ComboBox>

                <!-- Bouton Ajuster à la fenêtre -->
                <Button x:Name="FitToWindowButton" 
                Grid.Column="3"
                Style="{StaticResource ReaderButton}"
                Click="FitToWindowButton_Click"
                Margin="5,0"
                ToolTip="Ajuster à la fenêtre">
                    <TextBlock Text="⇔" FontSize="18"/>
                </Button>

                <!-- Bouton Plein écran -->
                <Button x:Name="FullscreenButton" 
                        Grid.Column="4"
                        Style="{StaticResource ReaderButton}"
                        Click="FullscreenButton_Click"
                        Margin="5,0">
                    <TextBlock Text="⛶"/>
                </Button>

                <!-- Bouton Favoris -->
                <Button x:Name="FavoriteButton" 
                        Grid.Column="5"
                        Style="{StaticResource ReaderButton}"
                        Click="FavoriteButton_Click"
                        Margin="5,0,0,0">
                    <TextBlock x:Name="FavoriteButtonText" Text="☆"/>
                </Button>
            </Grid>
        </Border>

        <!-- Zone de lecture -->
        <Grid Grid.Row="1" Background="Black">
            <!-- Mode page simple -->
            <ScrollViewer x:Name="SinglePageScrollViewer" 
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  CanContentScroll="False"
                  Visibility="Visible">
                <Grid>
                    <!-- Image centrée -->
                    <Image x:Name="CurrentPageImage" 
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

                    <!-- Zones de clic invisibles par-dessus l'image -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Zone gauche pour page précédente -->
                        <Border Grid.Column="0" 
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="LeftZone_Click">
                        </Border>

                        <!-- Zone droite pour page suivante -->
                        <Border Grid.Column="1" 
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="RightZone_Click">
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Mode double page -->
            <ScrollViewer x:Name="DoublePageScrollViewer"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  CanContentScroll="True"
                  Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image x:Name="LeftPageImage" 
                       Stretch="Uniform"
                       MaxHeight="800"
                       Margin="0,0,5,0"/>
                        <Image x:Name="RightPageImage" 
                       Stretch="Uniform"
                       MaxHeight="800"
                       Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- Zones de clic pour double page -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="LeftZone_Click"/>

                        <Border Grid.Column="1" 
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="RightZone_Click"/>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Mode défilement continu reste inchangé -->
            <ScrollViewer x:Name="ContinuousScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Visibility="Collapsed">
                <ItemsControl x:Name="AllPagesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}" 
                           Stretch="Uniform"
                           MaxWidth="1000"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Contrôles de navigation -->
        <Border Grid.Row="2" Background="{DynamicResource SecondaryBackgroundColor}"
BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation gauche -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="FirstPageButton" 
                    Style="{StaticResource ReaderButton}"
                    Click="FirstPageButton_Click"
                    Margin="0,0,5,0">
                        <TextBlock Text="⏮"/>
                    </Button>

                    <Button x:Name="PreviousPageButton" 
                    Style="{StaticResource ReaderButton}"
                    Click="PreviousPageButton_Click"
                    Margin="0,0,15,0">
                        <TextBlock Text="◀"/>
                    </Button>
                </StackPanel>

                <!-- Affichage du numéro de page au centre -->
                <Border Grid.Column="1" 
                Background="#2d2d30" 
                CornerRadius="4" 
                Padding="15,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Page " 
                           Foreground="White" 
                           FontSize="14"
                           VerticalAlignment="Center"/>
                        <TextBox x:Name="CurrentPageTextBox" 
                         Text="1"
                         Width="50"
                         Background="#1a1a1a"
                         Foreground="White"
                         BorderBrush="#404040"
                         BorderThickness="1"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="5,0"
                         PreviewTextInput="CurrentPageTextBox_PreviewTextInput"
                         KeyDown="CurrentPageTextBox_KeyDown"/>
                        <TextBlock Text=" / " 
                           Foreground="#CCCCCC" 
                           FontSize="14"
                           VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalPagesText" 
                           Text="1" 
                           Foreground="White" 
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation droite -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="NextPageButton" 
                    Style="{StaticResource ReaderButton}"
                    Click="NextPageButton_Click"
                    Margin="15,0,0,0">
                        <TextBlock Text="▶"/>
                    </Button>

                    <Button x:Name="LastPageButton" 
                    Style="{StaticResource ReaderButton}"
                    Click="LastPageButton_Click"
                    Margin="5,0,0,0">
                        <TextBlock Text="⏭"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>