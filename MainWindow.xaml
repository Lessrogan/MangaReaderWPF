    <Window x:Class="MangaReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manga Reader - Accueil" Height="800" Width="1200"
        Background="#1a1a1a" WindowState="Maximized">

    <Window.Resources>
        <!-- Styles pour les boutons -->
        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3d3d40"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les cartes de manga -->
        <Style x:Key="MangaCard" TargetType="Border">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3d3d40"/>
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Template pour les mangas -->
        <DataTemplate x:Key="MangaCardTemplate">
            <Border Style="{StaticResource MangaCard}" Width="180" Height="280">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Image de couverture -->
                    <Border Grid.Row="0" CornerRadius="8,8,0,0" Margin="5,5,5,0">
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Informations du manga -->
                    <StackPanel Grid.Row="1" Margin="10,5">
                        <TextBlock Text="{Binding Title}" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding Author}" 
                                   Foreground="#CCCCCC" 
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding LastReadFormatted}" 
                                   Foreground="#888888" 
                                   FontSize="9"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Contenu principal -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Titre principal -->
                <TextBlock Text="📚 Manga Reader" 
                           Foreground="White" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <!-- Section Derniers mangas lus -->
                <StackPanel Margin="0,0,0,40">
                    <TextBlock Text="Derniers mangas lus" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <ItemsControl x:Name="RecentMangasList" ItemTemplate="{StaticResource MangaCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Message si aucun manga récent -->
                    <TextBlock x:Name="NoRecentMangasText" 
                               Text="Aucun manga lu récemment"
                               Foreground="#888888"
                               FontStyle="Italic"
                               Visibility="Collapsed"
                               Margin="10"/>
                </StackPanel>

                <!-- Section Tous les mangas -->
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Tous les mangas disponibles" 
                                   Foreground="White" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="MangaCountText" 
                                   Grid.Column="1"
                                   Foreground="#CCCCCC" 
                                   FontSize="14"
                                   VerticalAlignment="Bottom"/>
                    </Grid>

                    <ItemsControl x:Name="AllMangasList" ItemTemplate="{StaticResource MangaCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Message si aucun manga -->
                    <TextBlock x:Name="NoMangasText" 
                               Text="Aucun manga trouvé. Vérifiez le dossier de mangas."
                               Foreground="#888888"
                               FontStyle="Italic"
                               Visibility="Collapsed"
                               Margin="10"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Panneau latéral -->
        <Border Grid.Column="1" 
                Background="#252526" 
                BorderBrush="#404040" 
                BorderThickness="1,0,0,0">

            <StackPanel Margin="15">
                <TextBlock Text="Actions" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"/>

                <!-- Bouton Favoris -->
                <Button x:Name="FavoritesButton" 
                        Style="{StaticResource SideMenuButton}"
                        Click="FavoritesButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⭐" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Favoris" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Bouton Manga aléatoire -->
                <Button x:Name="RandomMangaButton" 
                        Style="{StaticResource SideMenuButton}"
                        Click="RandomMangaButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎲" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Manga aléatoire" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Bouton Actualiser -->
                <Button x:Name="RefreshButton" 
                        Style="{StaticResource SideMenuButton}"
                        Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Séparateur -->
                <Separator Margin="0,20" Background="#404040"/>

                <!-- Bouton Paramètres -->
                <Button x:Name="SettingsButton" 
                        Style="{StaticResource SideMenuButton}"
                        Click="SettingsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Statistiques -->
                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="Statistiques" 
                               Foreground="#CCCCCC" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="TotalMangasText" 
                               Text="Total: 0 mangas"
                               Foreground="#888888" 
                               FontSize="11"
                               Margin="5,2"/>

                    <TextBlock x:Name="FavoritesCountText" 
                               Text="Favoris: 0"
                               Foreground="#888888" 
                               FontSize="11"
                               Margin="5,2"/>

                    <TextBlock x:Name="RecentCountText" 
                               Text="Lus récemment: 0"
                               Foreground="#888888" 
                               FontSize="11"
                               Margin="5,2"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>